<title>قطوف | بيع مباشر</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Tahoma;background:#FFC0CB}
header{background:#007bff;color:white;padding:25px;text-align:center;font-size:22px;font-weight:bold}
.filters{ text-align:center;padding:15px;background:#e9ecef }
.filters button{ margin:6px;padding:10px 18px;border:none;background:#0056b3;color:white;border-radius:7px;cursor:pointer;font-size:16px }
.products{ display:flex;flex-wrap:wrap;justify-content:center;gap:25px;padding:25px }
.product{ background:white;width:260px;padding:18px;border-radius:14px;box-shadow:0 0 12px rgba(0,0,0,.1);text-align:center;transition:0.3s }
.product:hover{ transform:translateY(-4px); box-shadow:0 0 18px rgba(0,0,0,.15) }
.product img{ width:100%;border-radius:10px }
.product h3{ margin:12px 0 8px;font-size:19px;font-weight:bold }
.product p{margin:6px 0;font-weight:bold}
select{ width:100%;padding:9px;margin-top:8px;border-radius:6px }
.order-btn{ margin-top:12px;width:100%;padding:11px;background:#25D366;color:white;border:none;border-radius:7px;font-size:16px;cursor:pointer }
footer{ background:#222;color:white;text-align:center;padding:18px;margin-top:30px;font-size:16px }
.whatsapp{ position:fixed;bottom:20px;left:20px;background:#25D366;color:white;padding:14px 20px;border-radius:50px;text-decoration:none;font-size:18px;font-weight:bold }
</style>
</head>
  
